{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Rule set",
  "type": "object",
  "additionalProperties": false,
  "required": ["rule_set_id", "version", "description", "document_types", "rules"],
  "properties": {
    "rule_set_id": { "type": "string", "minLength": 1 },
    "version": { "type": "string", "minLength": 1 },
    "description": { "type": "string", "minLength": 1 },
    "document_types": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": { "pattern": "^[a-z][a-z0-9_]*$", "not": { "const": "unclassified" } },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["label", "date_fields"],
        "properties": {
          "label": { "type": "string", "minLength": 1 },
          "date_fields": {
            "type": "array",
            "uniqueItems": true,
            "items": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" }
          }
        }
      }
    },
    "rules": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/rule" }
    }
  },
  "$defs": {
    "severity": { "enum": ["recordkeeping", "disqualifying"] },
    "rule": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rule_id", "citation", "required_item", "applies_to", "satisfied_by",
        "selection", "currency", "severity_if_missing", "severity_if_out_of_date"
      ],
      "properties": {
        "rule_id": { "type": "string", "pattern": "^RS-[0-9]{2}$" },
        "citation": { "type": "string", "minLength": 1 },
        "required_item": { "type": "string", "minLength": 1 },
        "applies_to": { "enum": ["both", "cdl", "non_cdl", "variance_declared"] },
        "satisfied_by": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string" }
        },
        "selection": {
          "oneOf": [
            { "type": "null" },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["order", "by"],
              "properties": {
                "order": { "enum": ["earliest", "latest"] },
                "by": { "type": "string" }
              }
            }
          ]
        },
        "currency": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["kind"],
              "properties": { "kind": { "const": "none" } }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["kind", "date_field"],
              "properties": {
                "kind": { "const": "expiration" },
                "date_field": { "type": "string" }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["kind", "date_field", "months"],
              "properties": {
                "kind": { "const": "months_from" },
                "date_field": { "type": "string" },
                "months": { "type": "integer", "minimum": 1 },
                "basis": { "type": "string" }
              }
            }
          ]
        },
        "severity_if_missing": { "$ref": "#/$defs/severity" },
        "severity_if_out_of_date": {
          "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/severity" }]
        }
      }
    }
  }
}
